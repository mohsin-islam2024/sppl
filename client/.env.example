# ---------------------------------------------------------------------------
# SPPL client environment
# Copy to .env and fill in. Only VITE_-prefixed values reach the browser, and
# every one of them is PUBLIC by definition — never put a secret here.
# ---------------------------------------------------------------------------

# Express API base URL (no trailing slash)
VITE_API_BASE_URL=[localhost](http://localhost:5000/api/v1)

# Socket.IO server origin (the Render service URL in production)
VITE_SOCKET_URL=[localhost](http://localhost:5000)

# ---------------------------------------------------------------------------
# Firebase web configuration
# These are not secrets; they identify the project to the Firebase SDK.
# Restrict them in the Firebase console with HTTP referrer rules.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Analytics for Firebase (optional)
VITE_FIREBASE_MEASUREMENT_ID=
